<!--
  Ревью п.22: третий сетевой адаптер для живых тестов смены сети —
  ОТДЕЛЬНЫЙ от default (тестируемая сеть п.1) и vt-mgmt (управляющий
  канал, неприкосновенен). NAT (не host-only, как vt-mgmt) — нужен
  настоящий шлюз, отличный от default, чтобы проверять переключение
  физического маршрута между двумя реальными сетями.
-->
<network>
  <name>vt-test2</name>
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='virbr-vttest2' stp='on' delay='0'/>
  <ip address='192.168.222.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='192.168.222.2' end='192.168.222.254'/>
      <host mac='52:54:00:89:6c:87' ip='192.168.222.50'/>
    </dhcp>
  </ip>
</network>
