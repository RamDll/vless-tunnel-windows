<!--
  Стенд, п.1: отдельная host-only сеть для управляющего канала (SSH),
  изолированная от "default" (той сети, которую ломают сетевые тесты —
  kill-switch, дёрганье маршрутов, reboot). Без <forward> — libvirt делает
  её host-only: только хост и гости на этом мосту, наружу не NAT'ится.
  MAC в DHCP-резервации фиксирован — vmctl.sh рассчитывает на статический
  10.77.77.5, а не на динамический поиск IP (тот как раз ломают тесты).
-->
<network>
  <name>vt-mgmt</name>
  <bridge name='virbr-vtmgmt' stp='on' delay='0'/>
  <ip address='10.77.77.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='10.77.77.10' end='10.77.77.20'/>
      <host mac='52:54:00:89:6c:86' ip='10.77.77.5'/>
    </dhcp>
  </ip>
</network>
