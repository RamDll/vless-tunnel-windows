{
  "mux": {
    "enabled": false
  },
  "protocol": "vless",
  "settings": {
    "vnext": [
      {
        "address": "ws.example.com",
        "port": 443,
        "users": [
          {
            "encryption": "none",
            "id": "00000000-0000-4000-8000-000000000003"
          }
        ]
      }
    ]
  },
  "streamSettings": {
    "network": "ws",
    "security": "tls",
    "tlsSettings": {
      "alpn": [
        "h2",
        "http/1.1"
      ],
      "serverName": "ws.example.com"
    },
    "wsSettings": {
      "host": "ws.example.com",
      "path": "/path"
    }
  },
  "tag": "proxy"
}