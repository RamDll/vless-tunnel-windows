<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VlessTunnel.Service</RootNamespace>
    <!-- Пока не настоящая Windows-служба (план, этап 2: "через временный
         отладочный вход") — консольный хост, который делает on/off в
         рамках одного процесса. Установка как реальной службы — этап 4+. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../VlessTunnel.Core/VlessTunnel.Core.csproj" />
    <ProjectReference Include="../VlessTunnel.Native/VlessTunnel.Native.csproj" />
  </ItemGroup>

</Project>
