<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VlessTunnel.Service</RootNamespace>
    <!-- Три режима входа в один exe (план, 3.7): "run"/"serve" — отладочные
         консольные (этапы 2/4), "service" — настоящая служба Windows под
         SCM (то, что регистрирует установщик). -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../VlessTunnel.Core/VlessTunnel.Core.csproj" />
    <ProjectReference Include="../VlessTunnel.Native/VlessTunnel.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
  </ItemGroup>

</Project>
